@startuml
skinparam classAttributeIconSize 0

class Student {
    - studentId: String
    - name: String
    - email: String
    + viewAvailability(): List<Room>
    + bookRoom(room: Room, startTime: DateTime, endTime: DateTime): Booking
    + cancelBooking(booking: Booking): void
}

class Administrator {
    - administratorId: String
    - name: String
    - email: String
    + blockRoom(room: Room): void
    + unblockRoom(room: Room): void
    + reviewUsage(startDate: Date, endDate: Date): void
}

class Room {
    - roomId: String
    - roomNumber: String
    - status: RoomStatus
    + isAvailable(startTime: DateTime, endTime: DateTime): Boolean
    + block(): void
    + unblock(): void
}

class Booking {
    - bookingId: String
    - startTime: DateTime
    - endTime: DateTime
    - status: BookingStatus
    + create(): void
    + cancel(): void
}

enum RoomStatus {
    AVAILABLE
    BLOCKED
}

enum BookingStatus {
    ACTIVE
    CANCELLED
    COMPLETED
}

Student "1" -- "0..*" Booking : creates
Room "1" -- "0..*" Booking : reserved in
Administrator "1" -- "0..*" Room : manages

note right of Booking
  R2 Rule: Active bookings for the same room cannot overlap.
  Each booking belongs to exactly 1 student and 1 room.
end note

note bottom of Room
  R3 Rule: A blocked room cannot accept a new booking.
end note

@enduml